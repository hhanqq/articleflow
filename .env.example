ARTICLEFLOW_ENV=local

POSTGRES_USER=articleflow
POSTGRES_PASSWORD=articleflow
POSTGRES_DB=articleflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_ADDR=localhost:6379

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=articleflow-local
KAFKA_ARTICLE_SERVICE_GROUP=article-service
ARTICLE_DISCOVERED_TOPIC=article.discovered.v1
ARTICLE_CONSUMER_GROUP_ID=article-service
ARTICLE_CONSUMER_MAX_MESSAGES=0
FEED_SCORED_TOPIC=feed.item.scored.v1
RANKING_CONSUMER_GROUP_ID=ranking-service
RANKING_CONSUMER_MAX_MESSAGES=0
FEED_CONSUMER_GROUP_ID=feed-service
FEED_CONSUMER_MAX_MESSAGES=0
HABR_RSS_URL=https://habr.com/ru/rss/articles/?fl=ru
HABR_BASE_URL=https://habr.com
HABR_MAX_ATTEMPTS=3
HABR_RETRY_DELAY_MS=500
HABR_REQUEST_DELAY_MS=500
VC_BASE_URL=https://vc.ru
VC_RSS_FEED_URL=https://vc.ru/rss
CUSTOM_RSS_SOURCES=dzen=https://dzen.ru/rss,yandex=https://news.yandex.ru/index.rss

GATEWAY_HTTP_ADDR=:8080
PARSER_SERVICE_URL=http://localhost:8081
FEED_SERVICE_URL=http://localhost:8082
PARSER_HTTP_ADDR=:8081
FEED_HTTP_ADDR=:8082
ARTICLE_GRPC_ADDR=:9001
FEED_GRPC_ADDR=:9002
RANKING_GRPC_ADDR=:9004
ARTICLE_STORAGE_DRIVER=memory
ARTICLE_POSTGRES_DSN=postgres://articleflow:articleflow@localhost:5432/articleflow?sslmode=disable
FEED_STORAGE_DRIVER=memory
FEED_POSTGRES_DSN=postgres://articleflow:articleflow@localhost:5432/articleflow?sslmode=disable
